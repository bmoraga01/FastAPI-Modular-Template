APP_ENV=local
APP_ENCRYPTION_KEY=your_encryption_key
SECRET_KEY=your_secret_key
CORS_ORIGINS_URL = "http://localhost:5173"
TURNSTILE_SECRET=your_turnstile_secret

STORAGE_TYPE=local
LOCAL_STORAGE_DIR=uploads


# POSTGRES
POSTGRES_URL=postgresql+asyncpg://postgres:123456@localhost:5432/app_backend
POSTGRES_DB=app_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# REDIS
# REDIS_HOST: str
# REDIS_PORT: int


# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXP_MIN=30
REFRESH_TOKEN_EXP_DAYS=7
ACTIVATION_ATTEMPT_LIMIT=5
ACTIVATION_BLOCK_SECONDS=600

# Invitation
INVITATION_TOKEN_EXP_MIN=60